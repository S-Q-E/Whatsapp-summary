{
  "name": "whatsapp-ai-secretary",
  "version": "0.1.0",
  "description": "Local WhatsApp ingestion MVP (read-only) for AI secretary — Baileys 7.x + SQLite",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:ingest": "tsx watch src/scripts/ingest.ts",
    "dev:web": "npm --prefix web run dev",
    "web:install": "npm --prefix web install",
    "build:web": "npm --prefix web run build",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "TZ=UTC node --import tsx --test tests/*.test.ts",
    "analyze": "tsx src/scripts/analyze.ts",
    "digest": "tsx src/scripts/digest.ts",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "eval": "tsx src/scripts/eval.ts",
    "eval:compare": "tsx src/scripts/evalCompare.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:stats": "tsx src/scripts/stats.ts",
    "session:logout": "tsx src/scripts/logout.ts"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@fastify/static": "^10.1.5",
    "@hapi/boom": "^9.1.3",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/qrcode-terminal": "^0.12.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.16.2",
    "typescript": "^5.6.0"
  }
}
