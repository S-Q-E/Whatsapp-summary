# --- Logging ---
# pino level: trace|debug|info|warn|error (use info or warn in daily use)
LOG_LEVEL=info
# print pretty human-readable logs in terminal (true for local dev)
LOG_PRETTY=true
# if true, debug logs may include a truncated text preview (max 120 chars).
# never logs full message bodies at info level. keep false unless debugging.
LOG_MESSAGE_CONTENT=false

# --- WhatsApp session ---
# folder with Baileys auth creds (Signal keys). keep outside git, chmod 700.
AUTH_DIR=./data/auth
# browser name shown in WhatsApp > Linked devices
BROWSER_NAME=WhatsApp AI Secretary
# false = phone keeps receiving push notifications while the app runs (recommended for a doctor).
# true = WhatsApp treats this session as the active foreground device.
MARK_ONLINE_ON_CONNECT=false
# false = only new realtime messages are stored (recommended for MVP).
# true = phone will also push chat history on first connect (heavy, slow startup).
SYNC_FULL_HISTORY=false

# --- SQLite ---
# local database file (WAL mode). back it up as a single file.
SQLITE_PATH=./data/whatsapp.db

# --- HTTP server ---
WEB_HOST=127.0.0.1
WEB_PORT=3000
# пароль веб-интерфейса — обязателен всегда, кроме явного ALLOW_NO_AUTH=true
WEB_PASSWORD=
# ALLOW_NO_AUTH=true — только для локальных тестов (сервер громко предупредит в логе)
ALLOW_NO_AUTH=false
# доверять X-Forwarded-* от reverse proxy (иначе игнорируются)
TRUST_PROXY=false
# дополнительные Host сверх 127.0.0.1/localhost, через запятую (защита от DNS rebinding)
ALLOWED_HOSTS=

# --- Время и владелец ---
# единая зона: границы дня, промпт, UI
TIMEZONE=Asia/Almaty
# JID владельца (куда слать дайджест). Пусто = ещё не задан.
OWNER_JID=

# --- AI analysis ---
# auto = OpenRouter (если задан OPENROUTER_API_KEY), иначе Ollama,
# при недоступности — локальная эвристика с warning.
# explicit: openrouter | ollama | heuristic | mock (mock is for tests only).
AI_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
# RU-capable local model for the first test, e.g. qwen2.5:7b (ollama pull qwen2.5:7b)
AI_MODEL=qwen2.5:7b
AI_TIMEOUT_MS=120000
AI_TEMPERATURE=0
# планировщик анализа (шаг 5): период и лимит чатов за проход
ANALYZE_INTERVAL_MIN=2
ANALYZE_MAX_CHATS=10
# максимум волн анализа на чат за один тик (бэклог добирается следующими тиками)
MAX_WAVES_PER_TICK=3
# QR в терминал для standalone ingestion (в серверном режиме QR только в WEB)
QR_TERMINAL=false
# контекст чата для анализа: последние N сообщений за окно в днях
AI_CONTEXT_LIMIT=40
# уже разобранных сообщений докладывать в окно как контекст (по умолчанию 15)
AI_CONTEXT_PRIOR=15
AI_CONTEXT_DAYS=14
# какие новые чаты анализировать: none — никакие, direct — только лички (по умолчанию), all — все.
# явный переключатель в UI («Анализировать») перекрывает политику в обе стороны.
ANALYZE_NEW_CHATS=direct
# fallback auto-провайдера на эвристику при ошибке primary (созданное → needs_review)
ALLOW_HEURISTIC_FALLBACK=false
# время дневного дайджеста HH:MM в TIMEZONE
DIGEST_TIME=18:00
# бэкапы sqlite: папка и ротация (последние N)
BACKUP_DIR=./data/backups
BACKUP_KEEP_N=7
# ретеншн текстов сообщений в днях; 0 = выключено (задачи и метаданные остаются)
RETENTION_DAYS=0
# обезличивание закрытых задач (title/description) старше N дней; 0 = выключено
RETENTION_TASKS_DAYS=0
# транскрибация голосовых (шаг 10). ВЫКЛЮЧЕНА по умолчанию:
# аудиофайл уходит стороннему ASR-сервису (см. README «Куда уходят данные»).
TRANSCRIBE_VOICE=false
# OpenAI-совместимый endpoint (OpenAI, Groq, свой сервер)
TRANSCRIBE_URL=https://api.openai.com/v1
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_API_KEY=
TRANSCRIBE_LANGUAGE=auto
# минут ожидания транскрипта перед анализом молодого голосового
VOICE_GRACE_MIN=5

# --- OpenRouter (облако — для ноутбука без ресурсов под Ollama) ---
# ключ: https://openrouter.ai/keys → пополнить баланс → вписать сюда.
# никому не показывай и не коммить (.env уже в .gitignore).
OPENROUTER_API_KEY=
# дешёвая модель с надёжным JSON и русским языком; альтернативы:
# anthropic/claude-haiku-4.5, google/gemini-2.5-flash, x-ai/grok-4.1-fast
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=WhatsApp AI Secretary
# OPENROUTER_SITE_URL=https://example.com
